# Copia este fichero a ".env" y rellena los valores. NO subas ".env" al repositorio.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Base de datos (modo solo-DB, por defecto) ---
# Ruta del fichero SQLite donde el bot guarda los gastos (relativa al proyecto).
DB_PATH=data/gastos.db

# --- Google Sheets (LEGACY) ---
# NO se usan en el modo solo-DB actual. Solo hacían falta en la versión que
# escribía en Sheets (commit 512a889); se conservan por si se vuelve a ella.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Tabla de Gastos!A:I

# --- Autenticación Google (solo si FACTURAS_ACTIVAS=1, para subir a Drive) ---
# service_account (recomendado, Google Workspace) | oauth (fallback, Gmail gratuito)
GOOGLE_AUTH_MODE=service_account
GOOGLE_CREDENTIALS_PATH=config/credenciales-cuenta-servicio.json

# --- Google Drive ---
# (Opcional) ID de la Unidad compartida / carpeta raíz.
# Los IDs de carpeta por sección van en config/secciones.yaml
DRIVE_CARPETA_RAIZ_ID=

# --- Fases ---
# FACTURAS_ACTIVAS=0 -> solo gastos (mensaje de texto, sin subir foto a Drive).
# FACTURAS_ACTIVAS=1 -> además pide la foto/PDF y la sube a Drive (necesita Drive API + carpetas).
FACTURAS_ACTIVAS=0

# --- Pruebas ---
# DRY_RUN=1 prueba el flujo de Telegram SIN tocar Google
DRY_RUN=0

# --- Audio (notas de voz) ---
# AUDIO_ACTIVO=1 activa el registro de gastos por nota de voz (Whisper local + Ollama).
# Requiere ffmpeg, mlx-whisper instalado y el servidor de Ollama corriendo (ollama serve).
AUDIO_ACTIVO=0
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_HOST=http://localhost:11434
